{
  "name": "gestao-ocorrencias-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "prisma migrate deploy && node src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed:demo": "node prisma/seed-demo-data.js",
    "test": "jest --runInBand",
    "test:integration": "jest --runInBand tests/integration.test.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dotenv": "17.3.1",
    "express": "5.2.1",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.3",
    "multer": "2.4.0",
    "prisma": "6.19.3",
    "swagger-ui-express": "5.0.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "jest": "30.2.0",
    "nodemon": "3.1.11",
    "supertest": "7.2.2"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
